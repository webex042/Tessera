{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "docs-site": {
      "root": "docs-site",
      "framework": "vitepress"
    },
    "ui": {
      "root": "ui",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/app/(.*)",
      "destination": { "service": "ui" }
    },
    {
      "source": "/app",
      "destination": { "service": "ui" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "docs-site" }
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
