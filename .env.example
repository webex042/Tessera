# Tessera LLM Provider Configuration (Optional Cloud Mode)
#
# By default, Tessera runs strictly offline using local llama.cpp (`TSR_LLM_PROVIDER=local`).
# Groq is strictly opt-in and only active when compiled with `--features groq` AND
# explicitly enabled below. Never commit a real `.env` file with your secret key.

# "local" (default) or "groq"
TSR_LLM_PROVIDER=local

# Required only when TSR_LLM_PROVIDER=groq (generate a fresh key at https://console.groq.com/keys)
GROQ_API_KEY=your_new_key_here

# Groq model identifier
GROQ_MODEL=openai/gpt-oss-20b

# Reasoning depth for gpt-oss models ("low" | "medium" | "high")
GROQ_REASONING_EFFORT=low

# Optional custom OpenAI-compatible HTTPS endpoint (e.g., an authenticated reverse proxy)
# TSR_GROQ_BASE_URL=https://api.groq.com/openai/v1
